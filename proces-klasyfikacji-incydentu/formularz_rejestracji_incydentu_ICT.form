{
  "components": [
    {
      "text": "## Rejestracja incydentu ICT (DORA)\nWprowadź dane incydentu. System oceni jego poziom, a decyzję zatwierdzi pracownik banku.",
      "type": "text",
      "id": "Text_intro",
      "layout": {
        "row": "Row_1",
        "columns": null
      }
    },
    {
      "text": "### 1. Rejestracja incydentu {{incidentId}}",
      "type": "text",
      "id": "Text_s1",
      "layout": {
        "row": "Row_2",
        "columns": null
      }
    },
    {
      "subtype": "datetime",
      "type": "datetime",
      "key": "detectedAt",
      "label": "Wykryto (data i godzina)",
      "id": "Field_detectedAt",
      "use24h": true,
      "timeSerializingFormat": "utc_offset",
      "timeInterval": 15,
      "dateLabel": "Data",
      "timeLabel": "Godzina",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_3",
        "columns": null
      }
    },
    {
      "label": "Źródło wykrycia",
      "values": [
        {
          "label": "Monitoring (SIEM)",
          "value": "Monitoring (SIEM)"
        },
        {
          "label": "Alert dostawcy chmury",
          "value": "Alert dostawcy chmury"
        },
        {
          "label": "Zgłoszenie pracownika",
          "value": "Zgłoszenie pracownika"
        },
        {
          "label": "Zgłoszenie klienta",
          "value": "Zgłoszenie klienta"
        },
        {
          "label": "Kontrahent",
          "value": "Kontrahent"
        }
      ],
      "type": "select",
      "key": "detectionSource",
      "id": "Field_source",
      "defaultValue": "Monitoring (SIEM)",
      "layout": {
        "row": "Row_3",
        "columns": null
      },
      "validate": {
        "required": true
      }
    },
    {
      "label": "Dotknięta usługa",
      "values": [
        {
          "label": "Płatności kartowe",
          "value": "Płatności kartowe"
        },
        {
          "label": "Przelewy natychmiastowe",
          "value": "Przelewy natychmiastowe"
        },
        {
          "label": "Bankowość internetowa",
          "value": "Bankowość internetowa"
        },
        {
          "label": "Raportowanie wewnętrzne",
          "value": "Raportowanie wewnętrzne"
        }
      ],
      "type": "select",
      "key": "affectedService",
      "id": "Field_service",
      "defaultValue": "Płatności kartowe",
      "layout": {
        "row": "Row_4",
        "columns": null
      },
      "validate": {
        "required": true
      }
    },
    {
      "label": "Opis zdarzenia",
      "type": "textarea",
      "key": "incidentDescription",
      "id": "Field_desc",
      "layout": {
        "row": "Row_5",
        "columns": null
      }
    },
    {
      "text": "### Krytyczność usługi",
      "type": "text",
      "id": "Text_crit_header",
      "layout": {
        "row": "Row_6",
        "columns": null
      }
    },
    {
      "label": "Usługa wspiera funkcję krytyczną",
      "type": "checkbox",
      "key": "incidentAffectsCriticalFunction",
      "id": "Field_critical",
      "defaultValue": false,
      "description": "Art. 3 pkt 22: zakłócenie istotnie wpływa na wyniki finansowe, bezpieczeństwo, ciągłość usług lub zgodność z zezwoleniem.",
      "layout": {
        "row": "Row_7",
        "columns": null
      }
    },
    {
      "label": "Usługa wspiera funkcję istotną",
      "type": "checkbox",
      "layout": {
        "row": "Row_13j7mma",
        "columns": null
      },
      "id": "Field_1f9zr9k",
      "key": "incidentAffectsImportantFunction"
    },
    {
      "label": "Usługa wymaga upoważnienia/rejestracji lub podlega nadzorowi organów",
      "type": "checkbox",
      "key": "isRegulatedService",
      "id": "Field_regulated",
      "defaultValue": false,
      "layout": {
        "row": "Row_0zyv0jh",
        "columns": null
      }
    },
    {
      "label": "Skuteczny, złośliwy i nieuprawniony dostęp do sieci/systemów",
      "type": "checkbox",
      "key": "isMaliciousAccess",
      "id": "Field_maliciousAccess",
      "defaultValue": false,
      "layout": {
        "row": "Row_1qgab0t",
        "columns": null
      }
    },
    {
      "text": "### 2. Kryteria klasyfikacji (art. 18 ust. 1)\n**Ilościowe (lit. a)**\nWartości odnoszą się do klientów kontrahentów oraz tranzakcji związanych z usługą, której dotyczy incydent",
      "type": "text",
      "id": "Text_s2",
      "layout": {
        "row": "Row_8",
        "columns": null
      }
    },
    {
      "label": "Liczba dotkniętych klientów",
      "type": "number",
      "key": "affectedClientsCount",
      "id": "Field_clients",
      "defaultValue": 0,
      "validate": {
        "min": 0
      },
      "layout": {
        "row": "Row_9",
        "columns": null
      }
    },
    {
      "label": "Liczba dotkniętych kontrahentów",
      "type": "number",
      "key": "affectedCounterpartiesCount",
      "id": "Field_cps",
      "defaultValue": 0,
      "validate": {
        "min": 0
      },
      "layout": {
        "row": "Row_9",
        "columns": null
      }
    },
    {
      "label": "Liczba transakcji",
      "type": "number",
      "key": "affectedTransactionsCount",
      "id": "Field_txCount",
      "defaultValue": 0,
      "validate": {
        "min": 0
      },
      "layout": {
        "row": "Row_10",
        "columns": null
      }
    },
    {
      "label": "Kwota transakcji (EUR)",
      "type": "number",
      "key": "affectedTransactionsValueEur",
      "id": "Field_txValue",
      "defaultValue": 0,
      "validate": {
        "min": 0
      },
      "layout": {
        "row": "Row_10",
        "columns": null
      }
    },
    {
      "label": "Dotknięci klienci o dużym znaczeniu",
      "type": "checkbox",
      "key": "affectsKeyClients",
      "id": "Field_keyClients",
      "defaultValue": false,
      "layout": {
        "row": "Row_11",
        "columns": null
      }
    },
    {
      "label": "Dotknięci kontrahenci o dużym znaczeniu",
      "type": "checkbox",
      "key": "affectsKeyCounterparties",
      "id": "Field_keyCps",
      "defaultValue": false,
      "layout": {
        "row": "Row_11",
        "columns": null
      }
    },
    {
      "text": "**Skutki reputacyjne**",
      "type": "text",
      "id": "Text_rep_header",
      "layout": {
        "row": "Row_12",
        "columns": null
      }
    },
    {
      "label": "Incydent został opisany w mediach",
      "type": "checkbox",
      "key": "describedInMedia",
      "id": "Field_media",
      "defaultValue": false,
      "layout": {
        "row": "Row_13",
        "columns": null
      }
    },
    {
      "label": "Incydent doprowadził do powtarzających się skarg",
      "type": "checkbox",
      "key": "repeatedComplaints",
      "id": "Field_complaints",
      "defaultValue": false,
      "layout": {
        "row": "Row_13",
        "columns": null
      }
    },
    {
      "label": "Brak możliwości spełnienia wymogów regulacyjnych",
      "type": "checkbox",
      "key": "regulatoryImpact",
      "id": "Field_regLoss",
      "defaultValue": false,
      "layout": {
        "row": "Row_14",
        "columns": null
      }
    },
    {
      "label": "Ryzyko utraty klientów z istotnym wpływem na działalność banku",
      "type": "checkbox",
      "layout": {
        "row": "Row_14",
        "columns": 8
      },
      "id": "Field_0yujmxf",
      "key": "customerLoss"
    },
    {
      "text": "**Czasowe (lit. b) i geograficzne (lit. c)**",
      "type": "text",
      "id": "Text_s2b",
      "layout": {
        "row": "Row_15",
        "columns": null
      }
    },
    {
      "label": "Czas trwania incydentu (godz.)",
      "type": "number",
      "key": "incidentDurationHours",
      "id": "Field_dur",
      "defaultValue": 0,
      "validate": {
        "min": 0
      },
      "increment": 0.5,
      "layout": {
        "row": "Row_16",
        "columns": null
      }
    },
    {
      "label": "Przerwa w świadczeniu usług (godz.)",
      "type": "number",
      "key": "serviceDowntimeHours",
      "id": "Field_down",
      "defaultValue": 0,
      "validate": {
        "min": 0
      },
      "increment": 0.5,
      "layout": {
        "row": "Row_16",
        "columns": null
      }
    },
    {
      "label": "Liczba państw członkowskich UE, których dotyczy",
      "type": "number",
      "key": "affectedEuStatesCount",
      "id": "Field_states",
      "defaultValue": 1,
      "validate": {
        "min": 1
      },
      "layout": {
        "row": "Row_16",
        "columns": null
      }
    },
    {
      "text": "**Utrata danych (lit. d)**\nSpełnienie tego progu klasyfikuje incydent bezpośrednio jako poważny.",
      "type": "text",
      "id": "Text_s2c",
      "layout": {
        "row": "Row_17",
        "columns": null
      }
    },
    {
      "label": "Dostępność (trwale lub tymczasowo niedostępne / nienadające się do wykorzystania)",
      "type": "checkbox",
      "key": "availabilityLost",
      "id": "Field_dAvail",
      "defaultValue": false,
      "layout": {
        "row": "Row_18",
        "columns": null
      }
    },
    {
      "label": "Autentyczność (spadek wiarygodności źródła danych)",
      "type": "checkbox",
      "key": "authenticityLost",
      "id": "Field_dAuth",
      "defaultValue": false,
      "layout": {
        "row": "Row_1c6r8w4",
        "columns": null
      }
    },
    {
      "label": "Poufność (ujawniono / uzyskano nieuprawniony dostęp)",
      "type": "checkbox",
      "key": "confidentialityLost",
      "id": "Field_dConf",
      "defaultValue": false,
      "layout": {
        "row": "Row_0j1kgut",
        "columns": null
      }
    },
    {
      "label": "Integralność (nieupoważniona modyfikacja danych)",
      "type": "checkbox",
      "key": "integrityLost",
      "id": "Field_dInt",
      "defaultValue": false,
      "layout": {
        "row": "Row_19",
        "columns": null
      }
    },
    {
      "label": "Nastąpił udany, złośliwy i nieuprawniony dostęp do sieci i/lub systemów informatycznych, który może spowodować utratę danych",
      "type": "checkbox",
      "key": "dataLossUnauthorized",
      "id": "Field_dataLossAdverseImpact",
      "defaultValue": false,
      "layout": {
        "row": "Row_20",
        "columns": null
      }
    },
    {
      "text": "**Skutki gospodarcze (lit. f)**",
      "type": "text",
      "id": "Text_s2d",
      "layout": {
        "row": "Row_21",
        "columns": null
      }
    },
    {
      "label": "Koszty bezpośrednie (EUR)",
      "type": "number",
      "key": "directCostsEur",
      "id": "Field_cDir",
      "defaultValue": 0,
      "validate": {
        "min": 0
      },
      "layout": {
        "row": "Row_22",
        "columns": null
      }
    },
    {
      "label": "Koszty pośrednie (EUR)",
      "type": "number",
      "key": "indirectCostsEur",
      "id": "Field_cInd",
      "defaultValue": 0,
      "validate": {
        "min": 0
      },
      "layout": {
        "row": "Row_22",
        "columns": null
      }
    },
    {
      "label": "Straty: rzeczywiste i utracone korzyści (EUR)",
      "type": "number",
      "key": "lossesEur",
      "id": "Field_cLoss",
      "defaultValue": 0,
      "validate": {
        "min": 0
      },
      "layout": {
        "row": "Row_22",
        "columns": 4
      }
    },
    {
      "label": "Prawdopodobne koszty i straty (EUR)",
      "type": "number",
      "layout": {
        "row": "Row_22",
        "columns": null
      },
      "id": "Field_0p2kzgb",
      "key": "probableCosts",
      "defaultValue": 0
    },
    {
      "label": "Zarejestruj incydent",
      "action": "submit",
      "type": "button",
      "id": "Button_submit",
      "layout": {
        "row": "Row_23",
        "columns": null
      }
    }
  ],
  "type": "default",
  "id": "Form_incydent_rejestracja",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.1"
  },
  "schemaVersion": 19
}