<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_IncidentClassification_C8" name="Klasyfikacja poważnego incydentu ICT" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="5.51.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <decision id="Decision_incydent_ICT" name="Klasyfikacja incydentu ICT">
    <variable id="Variable_1" name="Klasyfikacja incydentu ICT" typeRef="Any" />
    <decisionTable id="DecisionTable_1lllhta" hitPolicy="FIRST">
      <input id="Input_1" label="Usługa krytyczna">
        <inputExpression id="InputExpression_1" typeRef="boolean">
          <text>supportsCriticalFunction or isRegulatedService or isMaliciousAccess</text>
        </inputExpression>
      </input>
      <input id="InputClause_12zwjn4" label="Nieuprawniony dostęp mogący spowodować utratę danych">
        <inputExpression id="LiteralExpression_02tg26s" typeRef="boolean">
          <text>dataLossUnauthorized</text>
        </inputExpression>
      </input>
      <input id="InputClause_1u5c6f5" label="Liczba naruszeń pozostałych progów">
        <inputExpression id="LiteralExpression_1g6av9m" typeRef="number">
          <text>(if ((if totalClientsCount &gt; 0 then affectedClientsCount / totalClientsCount &gt; 0.10 else false) or (affectedClientsCount &gt; 100000) or (if totalCounterpartiesCount &gt; 0 then affectedCounterpartiesCount / totalCounterpartiesCount &gt; 0.30 else false) or (if avgDailyTransactionsCount &gt; 0 then affectedTransactionsCount / avgDailyTransactionsCount &gt; 0.10 else false) or (if avgDailyTransactionsValueEur &gt; 0 then affectedTransactionsValueEur / avgDailyTransactionsValueEur &gt; 0.10 else false) or affectsKeyClients or affectsKeyCounterparties) then 1 else 0) + (if (describedInMedia or repeatedComplaints or regulatoryImpact or customerLoss) then 1 else 0) + (if ((incidentDurationHours &gt; 24) or (supportsCriticalFunction and serviceDowntimeHours &gt; 2)) then 1 else 0) + (if (affectedEuStatesCount &gt;= 2) then 1 else 0) + (if (availabilityLost or authenticityLost or integrityLost or confidentialityLost) then 1 else 0) + (if (((directCostsEur + indirectCostsEur + lossesEur) &gt; 100000) and ((if totalClientsCount &gt; 0 then affectedClientsCount / totalClientsCount &gt; 0.10 else false) or (affectedClientsCount &gt; 100000) or (if totalCounterpartiesCount &gt; 0 then affectedCounterpartiesCount / totalCounterpartiesCount &gt; 0.30 else false) or (if avgDailyTransactionsCount &gt; 0 then affectedTransactionsCount / avgDailyTransactionsCount &gt; 0.10 else false))) then 1 else 0)</text>
        </inputExpression>
      </input>
      <output id="Output_1" label="Wynik klasyfikacji systemowej" name="systemClassificationResult" typeRef="string" />
      <rule id="DecisionRule_12uu91g">
        <description></description>
        <inputEntry id="UnaryTests_15tic4r">
          <text>false</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1fhtz6l">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_0sddinm">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0foma5k">
          <text>"standardowy"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1xf55cl">
        <description></description>
        <inputEntry id="UnaryTests_18jxtxz">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_131i7nr">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_10xp8wy">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0wk0ofc">
          <text>"poważny"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0c14f37">
        <description></description>
        <inputEntry id="UnaryTests_0coc3lv">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1cwzi44">
          <text>false</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0996i5m">
          <text>&gt;=2</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1b2gix4">
          <text>"poważny"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_15vtczd">
        <description></description>
        <inputEntry id="UnaryTests_06mj9b1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1ru6y55">
          <text>false</text>
        </inputEntry>
        <inputEntry id="UnaryTests_09pz6hv">
          <text>&lt;2</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1dwxx0v">
          <text>"standardowy"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram>
      <dmndi:DMNShape id="Decision_1snxvhp_di" dmnElementRef="Decision_incydent_ICT">
        <dc:Bounds height="80" width="180" x="150" y="80" />
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
